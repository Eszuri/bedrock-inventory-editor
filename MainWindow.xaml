<Window x:Class="BedrockInventoryEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:controls="clr-namespace:BedrockInventoryEditor.UI.Controls"
        xmlns:map="clr-namespace:BedrockInventoryEditor.UI.Controls.Map"
        xmlns:converters="clr-namespace:BedrockInventoryEditor.UI.Converters"
        mc:Ignorable="d"
        Title="Minecraft Bedrock Inventory Editor" 
        Icon="pack://application:,,,/BedrockInventoryEditor;component/Assets/app_icon.png"
        Height="820" Width="1340"
        MinHeight="720" MinWidth="1120"
        WindowStartupLocation="CenterScreen"
        Background="#0E1117" 
        Foreground="#F1F5F9"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        AllowDrop="True"
        Drop="OnWindowDrop"
        DragOver="OnWindowDragOver">

    <Window.Resources>
        <!-- Sidebar Navigation TabControl Template -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid Background="#0A0D14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="230"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left Sidebar Navigation Rail -->
                            <Border Grid.Column="0" Background="#0C0F17" BorderBrush="#1C263C" BorderThickness="0,0,1,0" Padding="12,14">
                                <StackPanel>
                                    <TextBlock Text="NAVIGASI EDITOR" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="8,0,0,10"/>
                                    <StackPanel IsItemsHost="True"/>
                                </StackPanel>
                            </Border>

                            <!-- Right Content Workspace Area -->
                            <Border Grid.Column="1" Background="Transparent">
                                <ContentPresenter ContentSource="SelectedContent"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar Navigation TabItem Template -->
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="1" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- Active Indicator Bar on Left -->
                                <Border x:Name="ActiveIndicator" Grid.Column="0" Width="3" Height="16" Background="#38BDF8" CornerRadius="1.5" Margin="0,0,10,0" Visibility="Collapsed"/>
                                <ContentPresenter Grid.Column="1" ContentSource="Header" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#182236"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#2A3C60"/>
                                <Setter TargetName="ActiveIndicator" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#131B2A"/>
                                <Setter Property="Foreground" Value="#F1F5F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- ComboBox Item Styling -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#F1F5F9"/>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- ========================================== -->
        <!-- 1. HOME VIEW (FLUENT HERO WELCOME SCREEN)  -->
        <!-- ========================================== -->
        <Grid x:Name="ViewHome" Visibility="Visible" Background="#0A0D14">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Centered Welcome Hub -->
            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel MaxWidth="960" Margin="24,36" HorizontalAlignment="Center" VerticalAlignment="Center">
                    
                    <!-- App Logo & Branding Header -->
                    <StackPanel HorizontalAlignment="Center" Margin="0,0,0,32">
                        <ui:Card Margin="0,0,0,14" Padding="10" HorizontalAlignment="Center">
                            <Image Source="Assets/app_icon.png" Width="48" Height="48" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                        </ui:Card>
                        <TextBlock Text="Minecraft Bedrock Inventory Editor" FontSize="26" FontWeight="Bold" Foreground="#F1F5F9" HorizontalAlignment="Center"/>
                        <TextBlock Text="Editor inventaris, perlengkapan armor, ender chest, dan pengaturan dunia Bedrock Edition." FontSize="13" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- 2-Column Hub Layout: Quick Actions & Recent Worlds -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="1.2*"/>
                        </Grid.ColumnDefinitions>

                        <!-- LEFT COLUMN: Open Options & Drag Drop Area -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="PILIH WORLD" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,10"/>

                            <!-- Button 1: Open World Folder -->
                            <ui:CardAction Margin="0,0,0,10" Padding="14,12" Click="OnOpenFolderClick">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Symbol="FolderOpen24" FontSize="26" Foreground="#38BDF8" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Buka Folder World..." FontSize="14" FontWeight="Bold" Foreground="#F1F5F9"/>
                                        <TextBlock Text="Pilih folder save world Bedrock di drive mana pun (C:, D:, USB, BDS)" FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </ui:CardAction>

                            <!-- Button 2: Open .mcworld Package -->
                            <ui:CardAction Margin="0,0,0,12" Padding="14,12" Click="OnOpenMcWorldClick">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Symbol="Archive24" FontSize="26" Foreground="#F59E0B" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Buka File .mcworld..." FontSize="14" FontWeight="Bold" Foreground="#F59E0B"/>
                                        <TextBlock Text="Buka langsung file arsip paket world .mcworld atau .zip" FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </ui:CardAction>

                            <!-- Drop Zone Card -->
                            <ui:Card Padding="14,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="24" Foreground="#38BDF8" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Seret &amp; Lepas (Drag &amp; Drop)" FontWeight="Bold" FontSize="12" Foreground="#38BDF8"/>
                                        <TextBlock Text="Tarik folder world atau file .mcworld ke jendela ini untuk langsung membukanya." FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </ui:Card>
                        </StackPanel>

                        <!-- RIGHT COLUMN: Recent Worlds List -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="RIWAYAT WORLD TERAKHIR" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,10"/>
                            
                            <ui:Card Padding="14" MinHeight="236">
                                <ScrollViewer MaxHeight="270" VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="PnlRecentWorldsList"/>
                                </ScrollViewer>
                            </ui:Card>
                        </StackPanel>
                    </Grid>

                </StackPanel>
            </ScrollViewer>

            <!-- Home Status Bar -->
            <Border Grid.Row="1" Background="#080A10" BorderBrush="#1C2438" BorderThickness="0,1,0,0" Padding="18,8">
                <DockPanel LastChildFill="True">
                    <Border DockPanel.Dock="Right" Background="#112218" BorderBrush="#1C452E" BorderThickness="1" CornerRadius="4" Padding="7,2">
                        <TextBlock Text="v1.0" Foreground="#10B981" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Siap. Silakan buka folder world atau pilih dari riwayat untuk memulai." Foreground="#64748B" FontSize="11" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>
        </Grid>


        <!-- ========================================================= -->
        <!-- 2. EDITOR VIEW (SIDEBAR NAVIGATION + FULL PAGE WORKSPACE) -->
        <!-- ========================================================= -->
        <Grid x:Name="ViewEditor" Visibility="Collapsed" Background="#0A0D14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Top App Header -->
                <RowDefinition Height="*"/>    <!-- Main Body Split (Sidebar + Content) -->
                <RowDefinition Height="Auto"/> <!-- Bottom Status Bar -->
            </Grid.RowDefinitions>

            <!-- TOP APP HEADER -->
            <Border Grid.Row="0" Background="#0F1420" BorderBrush="#1C263C" BorderThickness="0,0,0,1" Padding="16,10">
                <DockPanel LastChildFill="True">
                    <!-- Left: Logo & World Indicator -->
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <Border Width="28" Height="28" Background="#182238" BorderBrush="#283858" BorderThickness="1" CornerRadius="6" Margin="0,0,10,0" VerticalAlignment="Center">
                            <Image Source="Assets/app_icon.png" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                        </Border>
                        <TextBlock Text="Bedrock Editor" FontWeight="Bold" FontSize="13" Foreground="#F1F5F9" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        
                        <!-- World Pill -->
                        <Border Background="#141C2E" CornerRadius="6" BorderBrush="#22304E" BorderThickness="1" Padding="10,4" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🌍 " FontSize="11" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtToolbarWorldName" Text="World Aktif" Foreground="#10B981" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Right Buttons: Home & Save -->
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <ui:Button Icon="{ui:SymbolIcon FolderOpen24}" Content="Buka Lain" Margin="0,0,8,0" Padding="12,6" Appearance="Secondary" Click="OnOpenFolderClick"/>
                        <ui:Button Icon="{ui:SymbolIcon Home24}" Content="Beranda" Margin="0,0,12,0" Padding="12,6" Appearance="Secondary" Click="OnBackToHomeClick"/>
                        <ui:Button Icon="{ui:SymbolIcon Save24}" Content="Simpan ke LevelDB" Appearance="Primary" FontWeight="Bold" Padding="18,7" Click="OnSaveToWorldClick"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- MAIN BODY: TABCONTROL WITH LEFT SIDEBAR NAVIGATION -->
            <Grid Grid.Row="1">
                <TabControl TabStripPlacement="Left" Background="Transparent" BorderThickness="0">
                    
                    <!-- TAB 1: INVENTARIS & ARMOR -->
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Backpack24" FontSize="18" Foreground="#38BDF8" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Tas &amp; Armor" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </TabItem.Header>

                        <!-- Content 1: Player Inventory Page -->
                        <Grid Margin="16" Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="260"/> <!-- Left: Armor & Character Card -->
                                <ColumnDefinition Width="16"/>  <!-- Spacer -->
                                <ColumnDefinition Width="*"/>   <!-- Right: Bag & Hotbar Grid -->
                            </Grid.ColumnDefinitions>

                            <!-- Left: Equipment Card -->
                            <ui:Card Grid.Column="0" Padding="14">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <Border Background="#0D111A" CornerRadius="6" Padding="12" Margin="0,0,0,14" BorderBrush="#1C2438" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="PEMAIN AKTIF" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                                                <TextBlock x:Name="TxtActiveWorldName" Text="Belum ada world dimuat" FontSize="14" FontWeight="Bold" Foreground="#F59E0B" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                                <TextBlock x:Name="TxtPlayerKey" Text="Key: ~local_player" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <TextBlock Text="ARMOR &amp; OFFHAND" FontWeight="Bold" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,10"/>

                                        <!-- Armor Grid -->
                                        <Grid HorizontalAlignment="Center" Margin="0,0,0,14">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="14"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Armor Slots (Column 0) -->
                                            <controls:InventorySlotControl x:Name="SlotHelmet" Grid.Row="0" Grid.Column="0" Margin="0,0,0,6"/>
                                            <controls:InventorySlotControl x:Name="SlotChestplate" Grid.Row="1" Grid.Column="0" Margin="0,0,0,6"/>
                                            <controls:InventorySlotControl x:Name="SlotLeggings" Grid.Row="2" Grid.Column="0" Margin="0,0,0,6"/>
                                            <controls:InventorySlotControl x:Name="SlotBoots" Grid.Row="3" Grid.Column="0" Margin="0,0,0,0"/>

                                            <!-- Offhand Slot (Column 2) -->
                                            <StackPanel Grid.Row="1" Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="Offhand" FontSize="10" FontWeight="SemiBold" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,0,0,3"/>
                                                <controls:InventorySlotControl x:Name="SlotOffhand"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Quick Guide Card -->
                                        <Border Background="#0D111A" CornerRadius="6" Padding="12" BorderBrush="#1C2438" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="💡 Petunjuk Singkat:" FontWeight="Bold" FontSize="11" Foreground="#38BDF8" Margin="0,0,0,4"/>
                                                <TextBlock Text="• Klik slot mana pun untuk mengedit item, jumlah, durabilitas, nama, dan enchant." FontSize="10" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,3"/>
                                                <TextBlock Text="• Pastikan Minecraft ditutup sebelum menyimpan." FontSize="10" Foreground="#94A3B8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </ui:Card>

                            <!-- Right: Bag & Hotbar Grid Card -->
                            <ui:Card Grid.Column="2" Padding="16">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <!-- Main Bag Header -->
                                        <TextBlock Text="Tas Utama (Main Inventory • 27 Slot)" FontWeight="Bold" FontSize="13" Foreground="#CBD5E1" Margin="0,0,0,8"/>

                                        <!-- Main Bag ItemsControl (3 Rows x 9 Columns) -->
                                        <Border Background="#0D111A" CornerRadius="6" Padding="8" BorderBrush="#1C2438" BorderThickness="1" HorizontalAlignment="Left" Margin="0,0,0,16">
                                            <ItemsControl x:Name="ItemsBag">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Rows="3" Columns="9"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <controls:InventorySlotControl Margin="2"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>

                                        <!-- Hotbar Header -->
                                        <TextBlock Text="Hotbar Cepat (1x9 Slot)" FontWeight="Bold" FontSize="13" Foreground="#F59E0B" Margin="0,0,0,8"/>

                                        <!-- Hotbar ItemsControl (1 Row x 9 Columns) -->
                                        <Border Background="#0D111A" CornerRadius="6" Padding="8" BorderBrush="#1C2438" BorderThickness="1" HorizontalAlignment="Left">
                                            <ItemsControl x:Name="ItemsHotbar">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Rows="1" Columns="9"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <controls:InventorySlotControl Margin="2"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </ui:Card>
                        </Grid>
                    </TabItem>

                    <!-- TAB 2: ENDER CHEST -->
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Eye24" FontSize="18" Foreground="#A855F7" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Ender Chest" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </TabItem.Header>

                        <!-- Content 2: Ender Chest Page -->
                        <ui:Card Margin="16" Padding="20">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top">
                                    <Border Background="#161324" BorderBrush="#322452" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,16" Width="520">
                                        <DockPanel LastChildFill="True">
                                            <ui:SymbolIcon Symbol="Eye24" FontSize="24" Foreground="#A855F7" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Inventaris Ender Chest (27 Slot)" FontWeight="Bold" FontSize="14" Foreground="#E9D5FF"/>
                                                <TextBlock Text="Slot penyimpanan pribadi yang terhubung antar dimensi." FontSize="11" Foreground="#A78BFA" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>

                                    <!-- Ender Chest ItemsControl (3x9) -->
                                    <Border Background="#0D111A" CornerRadius="8" Padding="10" BorderBrush="#1C2438" BorderThickness="1" HorizontalAlignment="Center">
                                        <ItemsControl x:Name="ItemsEnderChest">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Rows="3" Columns="9"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <controls:InventorySlotControl Margin="2"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </ui:Card>
                    </TabItem>

                    <!-- TAB 3: CONTAINER SEKITAR -->
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Box24" FontSize="18" Foreground="#F59E0B" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Peti &amp; Wadah Sekitar" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </TabItem.Header>

                        <!-- Content 3: Nearby Containers Split View -->
                        <Grid Margin="16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Filters & Search Bar -->
                                <RowDefinition Height="*"/>    <!-- Master-Detail Split View -->
                            </Grid.RowDefinitions>

                            <!-- Top Filters Bar -->
                            <ui:Card Grid.Row="0" Padding="12,8" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Radius Filter -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="Jarak:" Foreground="#94A3B8" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <ComboBox x:Name="CmbContainerRadius" Width="140" Height="32" VerticalContentAlignment="Center" Padding="8,0" SelectionChanged="OnContainerFilterChanged">
                                            <ComboBoxItem Content="Radius 32 Blok"/>
                                            <ComboBoxItem Content="Radius 64 Blok" IsSelected="True"/>
                                            <ComboBoxItem Content="Radius 128 Blok"/>
                                            <ComboBoxItem Content="Radius 256 Blok"/>
                                            <ComboBoxItem Content="Radius 500 Blok"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <!-- Type Filter -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="Tipe:" Foreground="#94A3B8" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <ComboBox x:Name="CmbContainerType" Width="150" Height="32" VerticalContentAlignment="Center" Padding="8,0" SelectionChanged="OnContainerFilterChanged">
                                            <ComboBoxItem Content="Semua Tipe" IsSelected="True"/>
                                            <ComboBoxItem Content="Peti &amp; Tong"/>
                                            <ComboBoxItem Content="Shulker Box"/>
                                            <ComboBoxItem Content="Pemasak &amp; Tungku"/>
                                            <ComboBoxItem Content="Redstone &amp; Mekanik"/>
                                            <ComboBoxItem Content="Dekorasi &amp; Lainnya"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <!-- Search Box -->
                                    <ui:TextBox x:Name="TxtSearchContainers" Grid.Column="2" Height="28" Margin="0,0,10,0" Padding="8,4" 
                                                PlaceholderText="Cari nama peti, koordinat, atau item..."
                                                TextChanged="OnContainerSearchTextChanged"/>

                                    <!-- Refresh Button -->
                                    <ui:Button x:Name="BtnRescanContainers" Grid.Column="3" Icon="{ui:SymbolIcon ArrowClockwise24}" Content="Pindai" Appearance="Secondary" FontWeight="Bold" Padding="14,4" Click="OnRescanContainersClick"/>
                                </Grid>
                            </ui:Card>

                            <!-- Master-Detail Content -->
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="300"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- LEFT: Container Selector List -->
                                <ui:Card Grid.Column="0" Padding="8">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <DockPanel Grid.Row="0" Margin="6,4,6,8">
                                            <TextBlock x:Name="TxtContainerCount" Text="0 Container Ditemukan" FontSize="11" FontWeight="Bold" Foreground="#F59E0B" VerticalAlignment="Center"/>
                                        </DockPanel>

                                        <!-- Containers ListBox -->
                                        <ListBox x:Name="LstNearbyContainers" Grid.Row="1" Background="Transparent" BorderThickness="0"
                                                 SelectionChanged="OnContainerSelectionChanged"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 ScrollViewer.CanContentScroll="True"
                                                 VirtualizingStackPanel.IsVirtualizing="True"
                                                 VirtualizingStackPanel.VirtualizationMode="Recycling">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#141C2E" CornerRadius="6" Padding="8,6" Margin="0,0,0,4" BorderBrush="#22304E" BorderThickness="1">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Icon -->
                                                            <Border Grid.Column="0" Width="32" Height="32" Background="#0D111A" CornerRadius="4" Margin="0,0,8,0">
                                                                <Image Source="{Binding BlockId, Converter={StaticResource ItemImage}}" 
                                                                       Width="24" Height="24" 
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" 
                                                                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                                            </Border>

                                                            <!-- Info -->
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="11" Foreground="#F1F5F9" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding CoordinatesText}" FontSize="9" Foreground="#64748B" Margin="0,1,0,0"/>
                                                            </StackPanel>

                                                            <!-- Distance Badge -->
                                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                                <Border Background="#112218" BorderBrush="#1C452E" BorderThickness="1" CornerRadius="3" Padding="5,1" Margin="0,0,0,2">
                                                                    <TextBlock Text="{Binding DistanceText}" FontSize="9" FontWeight="Bold" Foreground="#10B981"/>
                                                                </Border>
                                                                <TextBlock Text="{Binding FilledSlotsText}" FontSize="9" Foreground="#F59E0B" HorizontalAlignment="Right"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>

                                        <!-- Empty State -->
                                        <Border x:Name="PnlNoContainers" Grid.Row="1" Background="#111520" CornerRadius="6" Padding="14" VerticalAlignment="Center" Margin="8" Visibility="Collapsed">
                                            <StackPanel HorizontalAlignment="Center">
                                                <ui:SymbolIcon Symbol="Search24" FontSize="26" Foreground="#F59E0B" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                                <TextBlock Text="Tidak ada container ditemukan." FontWeight="Bold" FontSize="11" Foreground="#F59E0B" TextAlignment="Center" TextWrapping="Wrap"/>
                                                <TextBlock Text="Coba perbesar radius atau ubah filter pencarian." FontSize="10" Foreground="#64748B" TextAlignment="Center" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </ui:Card>

                                <!-- RIGHT: Selected Container Slot Grid -->
                                <ui:Card Grid.Column="2" Padding="12">
                                    <Grid x:Name="PnlSelectedContainer">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/> <!-- Header Info -->
                                            <RowDefinition Height="*"/>    <!-- Slots Grid Area -->
                                            <RowDefinition Height="Auto"/> <!-- Footer Tip -->
                                        </Grid.RowDefinitions>

                                        <!-- Header Info -->
                                        <Border Grid.Row="0" Background="#141C2E" CornerRadius="6" BorderBrush="#22304E" BorderThickness="1" Padding="10,7" Margin="0,0,0,10">
                                            <DockPanel LastChildFill="True">
                                                <Border DockPanel.Dock="Left" Width="32" Height="32" Background="#0D111A" CornerRadius="4" Margin="0,0,10,0">
                                                    <Image x:Name="ImgSelectedContainer" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <DockPanel>
                                                        <TextBlock x:Name="TxtSelectedContainerName" Text="Pilih container untuk melihat isi" FontWeight="Bold" FontSize="13" Foreground="#F1F5F9"/>
                                                        <Border x:Name="BadgeContainerDim" Background="#19243C" CornerRadius="3" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock x:Name="TxtSelectedContainerDim" Text="Overworld" FontSize="9" FontWeight="Bold" Foreground="#38BDF8"/>
                                                        </Border>
                                                    </DockPanel>
                                                    <TextBlock x:Name="TxtSelectedContainerCoords" Text="Koordinat: -" FontSize="10" Foreground="#64748B" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>

                                        <!-- Slots Grid Area -->
                                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                            <Border Background="#0D111A" CornerRadius="6" Padding="8" BorderBrush="#1C2438" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Top">
                                                <ItemsControl x:Name="ItemsContainerSlots">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <UniformGrid Rows="{Binding Tag.GridRows, RelativeSource={RelativeSource AncestorType=ItemsControl}, FallbackValue=3}"
                                                                         Columns="{Binding Tag.GridColumns, RelativeSource={RelativeSource AncestorType=ItemsControl}, FallbackValue=9}"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <controls:InventorySlotControl Margin="2"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Border>
                                        </ScrollViewer>

                                        <!-- Footer Tip -->
                                        <Border Grid.Row="2" Background="#141C2E" CornerRadius="6" BorderBrush="#22304E" BorderThickness="1" Padding="10,6" Margin="0,8,0,0">
                                            <TextBlock Text="💡 Klik slot mana pun untuk mengedit item, jumlah, durabilitas, atau enchantment di wadah ini." FontSize="10" Foreground="#64748B" VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </ui:Card>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <!-- TAB 4: WORLD SETTINGS & GAMERULES (FULL SCROLLABLE BENTO DASHBOARD WITH WPF-UI SWITCHES & INPUTS) -->
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Settings24" FontSize="18" Foreground="#10B981" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Pengaturan World" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </TabItem.Header>

                        <!-- Content 4: World Settings & GameRules Full Scrollable Dashboard -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16,12,20,20">
                            <StackPanel Margin="0,0,0,24">
                                
                                <!-- 1. HERO WORLD HEADER & ACTION CONTROL HUB -->
                                <ui:Card Padding="16,14" Margin="0,0,0,14">
                                    <StackPanel>
                                        <!-- Top Row: World Name & Action Buttons -->
                                        <DockPanel LastChildFill="True" Margin="0,0,0,12">
                                            <!-- Action Buttons Group -->
                                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                                <ui:Button x:Name="BtnReloadWorldSettings" Icon="{ui:SymbolIcon ArrowClockwise24}" Content="Muat Ulang" Padding="14,6" Margin="0,0,10,0" Appearance="Secondary" Click="OnReloadWorldSettingsClick"/>
                                                <ui:Button x:Name="BtnSaveWorldSettings" Icon="{ui:SymbolIcon Save24}" Content="Simpan Pengaturan" Padding="18,6" Appearance="Primary" FontWeight="Bold" Click="OnSaveWorldSettingsClick"/>
                                            </StackPanel>

                                            <!-- World Name Input -->
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="NAMA WORLD MINECRAFT:" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                                                <ui:TextBox x:Name="TxtWorldName" Height="34" Padding="10,0" FontWeight="Bold" FontSize="13" VerticalContentAlignment="Center" MaxWidth="460" HorizontalAlignment="Left"/>
                                            </StackPanel>
                                        </DockPanel>

                                        <!-- Middle Row: World Attributes Badges -->
                                        <WrapPanel Margin="0,0,0,12" VerticalAlignment="Center">
                                            <!-- Seed Card Badge -->
                                            <Border Background="#141C2E" BorderBrush="#22304E" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,0,10,6" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="🔑 Seed:" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="TxtWorldSeedDisplay" Text="-" FontSize="12" FontWeight="Bold" Foreground="#F1F5F9" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <ui:Button x:Name="BtnCopySeed" Icon="{ui:SymbolIcon Copy24}" Content="Salin" Padding="7,2" FontSize="10" FontWeight="Bold" Appearance="Secondary" Click="OnCopySeedClick" ToolTip="Salin Seed ke Clipboard"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Game Mode Selector -->
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,6">
                                                <TextBlock Text="Mode:" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <ComboBox x:Name="CmbGameMode" Height="34" Width="140" FontSize="12" FontWeight="SemiBold" VerticalContentAlignment="Center" Padding="10,0">
                                                    <ComboBoxItem Content="Survival" IsSelected="True"/>
                                                    <ComboBoxItem Content="Creative"/>
                                                    <ComboBoxItem Content="Adventure"/>
                                                    <ComboBoxItem Content="Spectator"/>
                                                </ComboBox>
                                            </StackPanel>

                                            <!-- Difficulty Selector -->
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,6">
                                                <TextBlock Text="Kesulitan:" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <ComboBox x:Name="CmbDifficulty" Height="34" Width="140" FontSize="12" FontWeight="SemiBold" VerticalContentAlignment="Center" Padding="10,0">
                                                    <ComboBoxItem Content="Peaceful"/>
                                                    <ComboBoxItem Content="Easy"/>
                                                    <ComboBoxItem Content="Normal" IsSelected="True"/>
                                                    <ComboBoxItem Content="Hard"/>
                                                </ComboBox>
                                            </StackPanel>

                                            <!-- Hardcore Toggle Badge -->
                                            <Border Background="#1C1014" BorderBrush="#3C1822" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,0,0,6" VerticalAlignment="Center">
                                                <CheckBox x:Name="ChkHardcore" Content="💀 Hardcore (1 Nyawa)" Foreground="#F43F5E" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                                            </Border>
                                        </WrapPanel>

                                        <!-- Bottom Row: Xbox Achievement Status Banner -->
                                        <Border x:Name="PnlAchievementStatus" Background="#161324" BorderBrush="#322452" BorderThickness="1" CornerRadius="8" Padding="14,9">
                                            <DockPanel LastChildFill="True">
                                                <ui:Button x:Name="BtnRestoreAchievements" DockPanel.Dock="Right" Icon="{ui:SymbolIcon Shield24}" Content="Pulihkan Status Achievement" Padding="14,6" FontWeight="Bold" FontSize="11" Appearance="Secondary" Click="OnRestoreAchievementsClick" ToolTip="Menyetel hasBeenLoadedInCreative = 0 dan mematikan cheat sehingga world bisa mendapatkan achievement Xbox kembali."/>
                                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                                    <TextBlock x:Name="TxtAchievementStatus" Text="🔒 Achievement Terkunci (Pernah Mode Creative / Cheat Aktif)" Foreground="#F59E0B" FontWeight="Bold" FontSize="12"/>
                                                    <TextBlock Text="World yang pernah membuka Creative/Cheat dikunci oleh game. Klik tombol di kanan agar dapat meraih trophy Xbox kembali." FontSize="10" Foreground="#A78BFA" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </StackPanel>
                                </ui:Card>

                                <!-- 2. MAIN 2-COLUMN DASHBOARD BENTO GRID -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="1*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- ======================================== -->
                                    <!-- LEFT COLUMN: Environment & Player Vitals -->
                                    <!-- ======================================== -->
                                    <StackPanel Grid.Column="0">
                                        
                                        <!-- CARD 1: ⏰ WAKTU & CUACA DUNIA (MANUAL INPUT) -->
                                        <ui:Card Padding="16,14" Margin="0,0,0,14">
                                            <StackPanel>
                                                <!-- Header with Day Stepper -->
                                                <DockPanel Margin="0,0,0,12">
                                                    <Border DockPanel.Dock="Right" Background="#141C2E" BorderBrush="#22304E" BorderThickness="1" CornerRadius="6" Padding="6,2">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="📅 Hari ke-" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                            <ui:Button Content="◀" Width="18" Height="18" Padding="0" FontWeight="Bold" FontSize="8" Appearance="Secondary" Click="OnDayDecrementClick"/>
                                                            <ui:TextBox x:Name="TxtDayCount" Width="40" Height="20" Padding="2,0" Foreground="#38BDF8" TextAlignment="Center" Text="1" FontWeight="Bold" FontSize="11" Margin="3,0" VerticalContentAlignment="Center"/>
                                                            <ui:Button Content="▶" Width="18" Height="18" Padding="0" FontWeight="Bold" FontSize="8" Appearance="Secondary" Click="OnDayIncrementClick"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="⏰ Waktu &amp; Cuaca Dunia" FontWeight="Bold" FontSize="13" Foreground="#38BDF8"/>
                                                        <TextBlock Text="Atur jam (ticks), siklus hari, dan cuaca" FontSize="10" Foreground="#64748B" Margin="0,1,0,0"/>
                                                    </StackPanel>
                                                </DockPanel>

                                                <!-- Digital Clock Box -->
                                                <Border Background="#0D111A" CornerRadius="6" Padding="12,7" Margin="0,0,0,10" BorderBrush="#1C2438" BorderThickness="1">
                                                    <DockPanel LastChildFill="True">
                                                        <TextBlock Text="STATUS WAKTU:" FontSize="10" FontWeight="Bold" Foreground="#64748B" VerticalAlignment="Center"/>
                                                        <TextBlock x:Name="TxtTimeOfDayLabel" Text="🕐 12:00 (6000 ticks) • Siang Hari" FontWeight="Bold" FontSize="11" Foreground="#F59E0B" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                    </DockPanel>
                                                </Border>

                                                <!-- Manual Input for Time Ticks -->
                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="Waktu (Ticks):" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                    <ui:TextBox x:Name="TxtTimeOfDay" Grid.Column="1" Height="28" Padding="8,0" Foreground="#38BDF8" FontWeight="Bold" FontSize="12" Text="6000" VerticalContentAlignment="Center" Margin="0,0,8,0" TextChanged="OnTimeOfDayTextChanged"/>
                                                    <ui:Button Grid.Column="2" Content="◀ -1000" Padding="8,3" FontSize="10" FontWeight="Bold" Appearance="Secondary" Click="OnTimeDecrementClick" Margin="0,0,4,0"/>
                                                    <ui:Button Grid.Column="3" Content="+1000 ▶" Padding="8,3" FontSize="10" FontWeight="Bold" Appearance="Secondary" Click="OnTimeIncrementClick"/>
                                                </Grid>

                                                <!-- 4 Quick Preset Time Pills -->
                                                <UniformGrid Rows="1" Columns="4" Margin="0,0,0,12">
                                                    <ui:Button Content="🌅 Pagi (1k)" Padding="4,5" FontSize="10" FontWeight="Bold" Margin="2" Appearance="Secondary" Foreground="#FB923C" Click="OnPresetMorningClick"/>
                                                    <ui:Button Content="☀️ Siang (6k)" Padding="4,5" FontSize="10" FontWeight="Bold" Margin="2" Appearance="Secondary" Foreground="#FACC15" Click="OnPresetNoonClick"/>
                                                    <ui:Button Content="🌇 Sore (12k)" Padding="4,5" FontSize="10" FontWeight="Bold" Margin="2" Appearance="Secondary" Foreground="#F87171" Click="OnPresetSunsetClick"/>
                                                    <ui:Button Content="🌙 Malam (18k)" Padding="4,5" FontSize="10" FontWeight="Bold" Margin="2" Appearance="Secondary" Foreground="#A78BFA" Click="OnPresetMidnightClick"/>
                                                </UniformGrid>

                                                <!-- Daylight Cycle Switch Row -->
                                                <Border Background="#141C2E" CornerRadius="6" Padding="10,6" BorderBrush="#22304E" BorderThickness="1" Margin="0,0,0,10">
                                                    <CheckBox x:Name="ChkDaylightCycle" Content="Pergerakan Matahari Berjalan (dodaylightcycle)" Foreground="#CBD5E1" FontSize="11" IsChecked="True"/>
                                                </Border>

                                                <!-- Weather Row -->
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="1.1*"/>
                                                        <ColumnDefinition Width="10"/>
                                                        <ColumnDefinition Width="0.9*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="Kondisi Cuaca:" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,3"/>
                                                        <ComboBox x:Name="CmbWeather" Height="34" FontSize="12" FontWeight="SemiBold" VerticalContentAlignment="Center" Padding="10,0">
                                                            <ComboBoxItem Content="Cerah (Clear)" IsSelected="True"/>
                                                            <ComboBoxItem Content="Hujan (Rain)"/>
                                                            <ComboBoxItem Content="Badai (Thunder)"/>
                                                        </ComboBox>
                                                    </StackPanel>
                                                    <Border Grid.Column="2" Background="#141C2E" CornerRadius="6" Padding="10,6" BorderBrush="#22304E" BorderThickness="1" VerticalAlignment="Bottom" Height="28">
                                                        <CheckBox x:Name="ChkWeatherCycle" Content="Cuaca Alami" Foreground="#CBD5E1" FontSize="11" IsChecked="True" VerticalAlignment="Center"/>
                                                    </Border>
                                                </Grid>
                                            </StackPanel>
                                        </ui:Card>

                                        <!-- CARD 2: ❤️ STATUS & ATRIBUT PEMAIN (MANUAL INPUT) -->
                                        <ui:Card Padding="16,14" Margin="0,0,0,14">
                                            <StackPanel>
                                                <TextBlock Text="❤️ Status &amp; Atribut Pemain (~local_player)" FontWeight="Bold" FontSize="13" Foreground="#F43F5E" Margin="0,0,0,12"/>

                                                <!-- Health / Darah Manual Input Row -->
                                                <TextBlock Text="Darah / Health (Max 40 HP):" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,3"/>
                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="65"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ui:Button Grid.Column="0" Content="◀" Width="24" Height="28" Padding="0" FontWeight="Bold" FontSize="9" Appearance="Secondary" Click="OnHealthDecrementClick" Margin="0,0,4,0"/>
                                                    <ui:TextBox x:Name="TxtHealth" Grid.Column="1" Height="28" Padding="4,0" Foreground="#F43F5E" FontWeight="Bold" FontSize="12" Text="20" TextAlignment="Center" VerticalContentAlignment="Center" Margin="0,0,4,0"/>
                                                    <ui:Button Grid.Column="2" Content="▶" Width="24" Height="28" Padding="0" FontWeight="Bold" FontSize="9" Appearance="Secondary" Click="OnHealthIncrementClick" Margin="0,0,8,0"/>
                                                    <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <ui:Button Content="❤️ 20 HP" Padding="8,4" FontSize="10" FontWeight="Bold" Margin="0,0,4,0" Appearance="Secondary" Foreground="#FDA4AF" Click="OnHealthFullClick"/>
                                                        <ui:Button Content="🛡️ 40 HP" Padding="8,4" FontSize="10" FontWeight="Bold" Appearance="Secondary" Foreground="#FDE047" Click="OnHealthDoubleClick"/>
                                                    </StackPanel>
                                                </Grid>

                                                <Border Height="1" Background="#1C2438" Margin="0,0,0,10"/>

                                                <!-- Hunger & Saturation Manual Input Row -->
                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="1*"/>
                                                        <ColumnDefinition Width="10"/>
                                                        <ColumnDefinition Width="1*"/>
                                                    </Grid.ColumnDefinitions>
                                                    
                                                    <!-- Hunger (Lapar) -->
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="Lapar (0 - 20):" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,3"/>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <ui:Button Grid.Column="0" Content="◀" Width="24" Height="28" Padding="0" FontWeight="Bold" FontSize="9" Appearance="Secondary" Click="OnHungerDecrementClick" Margin="0,0,4,0"/>
                                                            <ui:TextBox x:Name="TxtHunger" Grid.Column="1" Height="28" Padding="4,0" Foreground="#F59E0B" FontWeight="Bold" FontSize="12" Text="20" TextAlignment="Center" VerticalContentAlignment="Center" Margin="0,0,4,0"/>
                                                            <ui:Button Grid.Column="2" Content="▶" Width="24" Height="28" Padding="0" FontWeight="Bold" FontSize="9" Appearance="Secondary" Click="OnHungerIncrementClick"/>
                                                        </Grid>
                                                    </StackPanel>

                                                    <!-- Saturation -->
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Saturasi Makanan:" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,3"/>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <ui:TextBox x:Name="TxtSaturation" Grid.Column="0" Height="28" Padding="6,0" Text="20" FontWeight="Bold" FontSize="12" VerticalContentAlignment="Center" Margin="0,0,6,0"/>
                                                            <ui:Button Grid.Column="1" Content="🍗 Full" Height="28" Padding="8,0" FontSize="10" FontWeight="Bold" Appearance="Secondary" Foreground="#FDBA74" Click="OnHungerFullClick"/>
                                                        </Grid>
                                                    </StackPanel>
                                                </Grid>

                                                <Border Height="1" Background="#1C2438" Margin="0,0,0,10"/>

                                                <!-- XP Level & Progress Section -->
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="1*"/>
                                                        <ColumnDefinition Width="10"/>
                                                        <ColumnDefinition Width="1*"/>
                                                    </Grid.ColumnDefinitions>
                                                    
                                                    <!-- XP Level -->
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="Level XP:" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,3"/>
                                                        <ui:TextBox x:Name="TxtXpLevel" Height="28" Padding="6,0" Foreground="#10B981" FontWeight="Bold" FontSize="12" Text="30" TextAlignment="Center" VerticalContentAlignment="Center" Margin="0,0,0,4"/>
                                                        <StackPanel Orientation="Horizontal">
                                                            <ui:Button Content="30" Padding="6,2" FontSize="9" FontWeight="Bold" Margin="0,0,3,0" Appearance="Secondary" Foreground="#86EFAC" Click="OnXpLevel30Click"/>
                                                            <ui:Button Content="100" Padding="6,2" FontSize="9" FontWeight="Bold" Margin="0,0,3,0" Appearance="Secondary" Foreground="#86EFAC" Click="OnXpLevel100Click"/>
                                                            <ui:Button Content="1000" Padding="6,2" FontSize="9" FontWeight="Bold" Appearance="Secondary" Foreground="#86EFAC" Click="OnXpLevel1000Click"/>
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <!-- XP Progress % -->
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Progress XP (%):" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,3"/>
                                                        <ui:TextBox x:Name="TxtXpProgress" Height="28" Padding="6,0" Foreground="#38BDF8" FontWeight="Bold" FontSize="12" Text="0" TextAlignment="Center" VerticalContentAlignment="Center"/>
                                                        <TextBlock Text="Nilai dari 0 sampai 100%" FontSize="9" Foreground="#64748B" Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </ui:Card>

                                        <!-- CARD 3: 📍 TELEPORTASI TITIK KOORDINAT & DIMENSI -->
                                        <ui:Card Padding="16,14">
                                            <StackPanel>
                                                <TextBlock Text="📍 Teleportasi Titik Koordinat &amp; Dimensi" FontWeight="Bold" FontSize="13" Foreground="#38BDF8" Margin="0,0,0,10"/>
                                                
                                                <!-- Dimension Selector -->
                                                <TextBlock Text="PILIH DIMENSI:" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,3"/>
                                                <ComboBox x:Name="CmbPlayerDim" Height="34" FontSize="12" FontWeight="SemiBold" VerticalContentAlignment="Center" Padding="10,0" Margin="0,0,0,10">
                                                    <ComboBoxItem Content="Overworld (Dunia Atas)" IsSelected="True"/>
                                                    <ComboBoxItem Content="Nether (Neraka)"/>
                                                    <ComboBoxItem Content="The End (Dunia Akhir)"/>
                                                </ComboBox>

                                                <!-- Coordinates 3-Col -->
                                                <TextBlock Text="KOORDINAT POSISI PEMAIN:" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,3"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="8"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="8"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="X (Barat/Timur)" FontSize="10" Foreground="#94A3B8" Margin="0,0,0,2"/>
                                                        <ui:TextBox x:Name="TxtPlayerPosX" Height="26" Padding="4,0" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" VerticalContentAlignment="Center"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Y (Tinggi)" FontSize="10" Foreground="#94A3B8" Margin="0,0,0,2"/>
                                                        <ui:TextBox x:Name="TxtPlayerPosY" Height="26" Padding="4,0" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" VerticalContentAlignment="Center"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="4">
                                                        <TextBlock Text="Z (Utara/Selatan)" FontSize="10" Foreground="#94A3B8" Margin="0,0,0,2"/>
                                                        <ui:TextBox x:Name="TxtPlayerPosZ" Height="26" Padding="4,0" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" VerticalContentAlignment="Center"/>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </ui:Card>
                                    </StackPanel>

                                    <!-- ======================================== -->
                                    <!-- RIGHT COLUMN: GameRules Hub (Modern Switches) -->
                                    <!-- ======================================== -->
                                    <StackPanel Grid.Column="2">
                                        
                                        <!-- CARD 4: ⚙️ ATURAN GAME (GAMERULES) -->
                                        <ui:Card Padding="16,14">
                                            <StackPanel>
                                                <TextBlock Text="⚙️ Aturan Game (GameRules)" FontWeight="Bold" FontSize="13" Foreground="#10B981" Margin="0,0,0,2"/>
                                                <TextBlock Text="Aktifkan atau sesuaikan proteksi dan mekanik dunia" FontSize="10" Foreground="#64748B" Margin="0,0,0,12"/>

                                                <!-- Sub-Group 1: Golden Keep Inventory Highlight -->
                                                <Border Background="#1A150E" CornerRadius="6" Padding="12,10" BorderBrush="#3A2C18" BorderThickness="1" Margin="0,0,0,10">
                                                    <StackPanel>
                                                        <TextBlock Text="🎒 Kematian &amp; Drop Barang:" FontSize="10" FontWeight="Bold" Foreground="#F59E0B" Margin="0,0,0,8"/>
                                                        
                                                        <Border Background="#14110C" CornerRadius="5" Padding="8,5" Margin="0,0,0,5">
                                                            <CheckBox x:Name="ChkKeepInventory" Content="⭐ Keep Inventory (Item &amp; XP Aman Saat Mati)" Foreground="#FDE047" FontWeight="Bold" FontSize="11"/>
                                                        </Border>
                                                        
                                                        <Border Background="#14110C" CornerRadius="5" Padding="8,5" Margin="0,0,0,5">
                                                            <CheckBox x:Name="ChkImmediateRespawn" Content="⚡ Instant Respawn (Langsung hidup)" Foreground="#CBD5E1" FontSize="11"/>
                                                        </Border>

                                                        <Border Background="#14110C" CornerRadius="5" Padding="8,5" Margin="0,0,0,5">
                                                            <CheckBox x:Name="ChkMobGriefing" Content="💥 Mob Griefing (Creeper merusak)" Foreground="#CBD5E1" FontSize="11" IsChecked="True"/>
                                                        </Border>

                                                        <!-- Mini Row Switches -->
                                                        <Grid Margin="0,2,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="6"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="6"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0" Background="#14110C" CornerRadius="5" Padding="6,4">
                                                                <CheckBox x:Name="ChkMobLoot" Content="Mob Loot" Foreground="#CBD5E1" FontSize="10" IsChecked="True"/>
                                                            </Border>
                                                            <Border Grid.Column="2" Background="#14110C" CornerRadius="5" Padding="6,4">
                                                                <CheckBox x:Name="ChkTileDrops" Content="Block Drops" Foreground="#CBD5E1" FontSize="10" IsChecked="True"/>
                                                            </Border>
                                                            <Border Grid.Column="4" Background="#14110C" CornerRadius="5" Padding="6,4">
                                                                <CheckBox x:Name="ChkEntityDrops" Content="Entity Drops" Foreground="#CBD5E1" FontSize="10" IsChecked="True"/>
                                                            </Border>
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Sub-Group 2: Proteksi Kerusakan -->
                                                <Border Background="#141C2E" CornerRadius="6" Padding="12,10" BorderBrush="#22304E" BorderThickness="1" Margin="0,0,0,10">
                                                    <StackPanel>
                                                        <TextBlock Text="🛡️ Proteksi Kerusakan (Damage Immunity):" FontSize="10" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,6"/>
                                                        
                                                        <Border Background="#101626" CornerRadius="5" Padding="8,4" Margin="0,0,0,4">
                                                            <CheckBox x:Name="ChkFallDamage" Content="Fall Damage (Jatuh dari ketinggian)" Foreground="#CBD5E1" FontSize="11" IsChecked="True"/>
                                                        </Border>
                                                        <Border Background="#101626" CornerRadius="5" Padding="8,4" Margin="0,0,0,4">
                                                            <CheckBox x:Name="ChkFireDamage" Content="Fire / Lava Damage (Terbakar)" Foreground="#CBD5E1" FontSize="11" IsChecked="True"/>
                                                        </Border>
                                                        <Border Background="#101626" CornerRadius="5" Padding="8,4" Margin="0,0,0,4">
                                                            <CheckBox x:Name="ChkDrowningDamage" Content="Drowning (Tenggelam dalam air)" Foreground="#CBD5E1" FontSize="11" IsChecked="True"/>
                                                        </Border>
                                                        <Border Background="#101626" CornerRadius="5" Padding="8,4">
                                                            <CheckBox x:Name="ChkFreezeDamage" Content="Freeze (Membeku di salju bubuk)" Foreground="#CBD5E1" FontSize="11" IsChecked="True"/>
                                                        </Border>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Sub-Group 3: Lingkungan, Monster & HUD -->
                                                <Border Background="#141C2E" CornerRadius="6" Padding="12,10" BorderBrush="#22304E" BorderThickness="1" Margin="0,0,0,10">
                                                    <StackPanel>
                                                        <TextBlock Text="🌍 Lingkungan &amp; Tampilan Layar:" FontSize="10" FontWeight="Bold" Foreground="#86EFAC" Margin="0,0,0,6"/>
                                                        
                                                        <Border Background="#101626" CornerRadius="5" Padding="8,4" Margin="0,0,0,4">
                                                            <CheckBox x:Name="ChkMobSpawning" Content="🧟 Spawn Monster &amp; Hewan Alami" Foreground="#CBD5E1" FontSize="11" IsChecked="True"/>
                                                        </Border>
                                                        <Border Background="#101626" CornerRadius="5" Padding="8,4" Margin="0,0,0,4">
                                                            <CheckBox x:Name="ChkNaturalRegen" Content="💖 Natural Regen (Darah isi otomatis)" Foreground="#CBD5E1" FontSize="11" IsChecked="True"/>
                                                        </Border>
                                                        <Border Background="#101626" CornerRadius="5" Padding="8,4" Margin="0,0,0,4">
                                                            <CheckBox x:Name="ChkPvp" Content="⚔️ PVP (Damage Antar Pemain)" Foreground="#CBD5E1" FontSize="11" IsChecked="True"/>
                                                        </Border>
                                                        <Border Background="#101626" CornerRadius="5" Padding="8,4" Margin="0,0,0,4">
                                                            <CheckBox x:Name="ChkShowCoordinates" Content="📍 Tampilkan Koordinat di Layar" Foreground="#CBD5E1" FontSize="11" IsChecked="True"/>
                                                        </Border>
                                                        <Border Background="#101626" CornerRadius="5" Padding="8,4" Margin="0,0,0,4">
                                                            <CheckBox x:Name="ChkShowDaysPlayed" Content="📅 Tampilkan Hari Dimainkan di Layar" Foreground="#CBD5E1" FontSize="11" IsChecked="True"/>
                                                        </Border>
                                                        <Border Background="#101626" CornerRadius="5" Padding="8,4">
                                                            <CheckBox x:Name="ChkTntExplodes" Content="💣 TNT Meledak (TNT Explodes)" Foreground="#CBD5E1" FontSize="11" IsChecked="True"/>
                                                        </Border>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Sub-Group 4: Parameters (Tick Speed & Sleep) -->
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="10"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="Random Tick (Tanaman):" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,3"/>
                                                        <ui:TextBox x:Name="TxtRandomTickSpeed" Height="26" Padding="6,0" Foreground="#FFFFFF" Text="1" FontWeight="Bold" FontSize="11" VerticalContentAlignment="Center"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Sleeping % (Lewati Malam):" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,3"/>
                                                        <ui:TextBox x:Name="TxtSleepingPercent" Height="26" Padding="6,0" Foreground="#FFFFFF" Text="100" FontWeight="Bold" FontSize="11" VerticalContentAlignment="Center"/>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Sub-Group 5: Cheats & Commands -->
                                                <Border Height="1" Background="#1C2438" Margin="0,2,0,8"/>
                                                <TextBlock Text="KONTROL CHEAT &amp; PERINTAH:" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,6"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="8"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Background="#141C2E" CornerRadius="5" Padding="8,4">
                                                        <CheckBox x:Name="ChkCheatsEnabled" Content="👑 Cheats Enabled" Foreground="#CBD5E1" FontSize="10" FontWeight="SemiBold"/>
                                                    </Border>
                                                    <Border Grid.Column="2" Background="#141C2E" CornerRadius="5" Padding="8,4">
                                                        <CheckBox x:Name="ChkCommandsEnabled" Content="⌨️ Commands Enabled" Foreground="#CBD5E1" FontSize="10" FontWeight="SemiBold"/>
                                                    </Border>
                                                </Grid>
                                            </StackPanel>
                                        </ui:Card>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- TAB 5: PETA SEED & STRUKTUR (NATIVE CANVAS SEED MAP) -->
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Map24" FontSize="18" Foreground="#38BDF8" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Peta Seed (Native Canvas)" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </TabItem.Header>

                        <Grid Margin="16,12,16,16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Top Controls Toolbar -->
                                <RowDefinition Height="*"/>    <!-- Center Native Map Canvas Viewport -->
                            </Grid.RowDefinitions>

                            <!-- 1. TOP CONTROLS TOOLBAR -->
                            <ui:Card Grid.Row="0" Padding="14,10" Margin="0,0,0,10">
                                <StackPanel>
                                    <!-- Row 1: Seed, Target Coords, Jump, Teleport, Actions -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/> <!-- Seed -->
                                            <ColumnDefinition Width="14"/>
                                            <ColumnDefinition Width="Auto"/> <!-- Target X/Z -->
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/> <!-- Action Buttons -->
                                        </Grid.ColumnDefinitions>

                                        <!-- Seed Input -->
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="SEED DUNIA AKTIF:" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,3"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="190"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ui:TextBox x:Name="TxtMapSeed" Grid.Column="0" Height="30" Padding="8,0" FontWeight="Bold" FontSize="12" Foreground="#38BDF8" VerticalContentAlignment="Center" PlaceholderText="Masukkan seed dunia..." TextChanged="OnMapSeedInputChanged"/>
                                                <ui:Button x:Name="BtnCopyMapSeed" Grid.Column="1" Icon="{ui:SymbolIcon Copy24}" Margin="4,0,0,0" Padding="7,4" ToolTip="Salin Seed ke Clipboard" Appearance="Secondary" Click="OnCopyMapSeedClick"/>
                                            </Grid>
                                        </StackPanel>

                                        <!-- Target Coordinates X & Z -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="LOMPAT KE KOORDINAT (X, Z):" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,3"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="X:" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <ui:TextBox x:Name="TxtMapTargetX" Width="80" Height="30" Padding="6,0" Text="0" FontWeight="Bold" FontSize="11" VerticalContentAlignment="Center"/>
                                                <TextBlock Text="Z:" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center" Margin="8,0,4,0"/>
                                                <ui:TextBox x:Name="TxtMapTargetZ" Width="80" Height="30" Padding="6,0" Text="0" FontWeight="Bold" FontSize="11" VerticalContentAlignment="Center"/>
                                                <ui:Button Icon="{ui:SymbolIcon ArrowRight24}" Content="Tuju Titik" Height="30" Padding="12,0" Margin="8,0,0,0" Appearance="Primary" FontWeight="Bold" Click="OnNavigateSeedMapClick"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Right Quick Action Buttons -->
                                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Bottom">
                                            <ui:Button x:Name="BtnMapSyncPlayer" Icon="{ui:SymbolIcon Location24}" Content="📍 Lokasi Pemain" Padding="10,5" Margin="0,0,6,0" Appearance="Secondary" FontWeight="SemiBold" FontSize="11" Click="OnSyncPlayerLocationToMapClick" ToolTip="Pusatkan peta ke koordinat pemain saat ini"/>
                                            <ui:Button x:Name="BtnMapSpawnPoint" Icon="{ui:SymbolIcon Home24}" Content="🏠 Spawn" Padding="10,5" Margin="0,0,6,0" Appearance="Secondary" FontSize="11" Click="OnGoToSpawnPointClick" ToolTip="Pusatkan peta ke titik spawn utama (0, 0)"/>
                                            <ui:Button x:Name="BtnMapTeleportPlayer" Icon="{ui:SymbolIcon Flash24}" Content="⚡ Teleport Pemain" Padding="12,5" Margin="0,0,6,0" Appearance="Secondary" Foreground="#F59E0B" FontWeight="Bold" FontSize="11" Click="OnTeleportPlayerToMapCoordsClick" ToolTip="Ubah koordinat pemain ke titik koordinat target di atas"/>
                                            <ui:Button x:Name="BtnMapReload" Icon="{ui:SymbolIcon ArrowClockwise24}" Content="Refresh" Padding="10,5" Appearance="Secondary" FontSize="11" Click="OnReloadSeedMapClick" ToolTip="Render ulang canvas peta"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </ui:Card>

                            <!-- 2. CENTER NATIVE MAP CANVAS VIEWPORT -->
                            <Border Grid.Row="1" Background="#0A0D14" CornerRadius="8" BorderBrush="#1C263C" BorderThickness="1" ClipToBounds="True">
                                <map:NativeSeedMapControl x:Name="NativeSeedMap" TeleportRequested="OnNativeSeedMapTeleportRequested"/>
                            </Border>
                        </Grid>
                    </TabItem>

                </TabControl>
            </Grid>

            <!-- STATUS BAR -->
            <Border Grid.Row="2" Background="#080A10" BorderBrush="#1C263C" BorderThickness="0,1,0,0" Padding="16,6">
                <DockPanel LastChildFill="True">
                    <!-- Right: Version Badge & Loaded Path -->
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtLoadedPath" Text="" Foreground="#64748B" FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Border Background="#112218" BorderBrush="#1C452E" BorderThickness="1" CornerRadius="4" Padding="7,2" ToolTip="Versi Resmi 1.0">
                            <TextBlock Text="v1.0" Foreground="#10B981" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>

                    <!-- Left: Status Message -->
                    <TextBlock x:Name="TxtStatus" Text="Siap mengedit inventaris." Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
