<Window x:Class="BedrockInventoryEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:BedrockInventoryEditor.UI.Controls"
        mc:Ignorable="d"
        Title="Minecraft Bedrock Inventory Editor v1.0" 
        Icon="Assets/app_icon.png"
        Height="740" Width="1240"
        MinHeight="680" MinWidth="1080"
        WindowStartupLocation="CenterScreen"
        Background="#121216" 
        Foreground="#FFFFFF"
        FontFamily="Segoe UI"
        AllowDrop="True"
        Drop="OnWindowDrop"
        DragOver="OnWindowDragOver">

    <Window.Resources>
        <!-- Modern Buttons -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#252532"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#424256"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#38384C"/>
                    <Setter Property="BorderBrush" Value="#55FF55"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Modern TabItems -->
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="#1A1A24"/>
            <Setter Property="Foreground" Value="#BBBBCC"/>
            <Setter Property="BorderBrush" Value="#2E2E40"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="1,1,1,0" 
                                CornerRadius="6,6,0,0" 
                                Margin="0,0,4,0" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#262638"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#55FF55"/>
                                <Setter Property="Foreground" Value="#55FF55"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#2A2A3E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Top Toolbar -->
            <RowDefinition Height="*"/>    <!-- Main Body -->
            <RowDefinition Height="Auto"/> <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- TOP TOOLBAR (Clean, Free Folder World Editing) -->
        <Border Grid.Row="0" Background="#181822" BorderBrush="#2A2A3A" BorderThickness="0,0,0,1" Padding="14,10">
            <DockPanel LastChildFill="True">
                <!-- Left Buttons: Open Folder / .mcworld / Recent Worlds -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Button Content="📂 Buka Folder Bebas..." Margin="0,0,8,0" Padding="14,7" ToolTip="Pilih folder world Bedrock mana pun di drive Anda (C:, D:, USB, Dedicated Server)" Click="OnOpenFolderClick"/>
                    <Button Content="📦 Buka .mcworld..." Margin="0,0,16,0" Padding="14,7" ToolTip="Buka file paket world .mcworld langsung" Click="OnOpenMcWorldClick"/>

                    <!-- Recent Worlds Dropdown -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock Text="🕒 Riwayat World:" VerticalAlignment="Center" Foreground="#FFAA00" Margin="0,0,8,0" FontSize="13" FontWeight="SemiBold"/>
                        <ComboBox x:Name="CmbRecentWorlds" Width="360" Height="34" SelectionChanged="OnRecentWorldSelectionChanged"/>
                    </StackPanel>
                </StackPanel>

                <!-- Right Button: Save to LevelDB -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Button Content="💾 Simpan ke LevelDB" Background="#1E6B23" BorderBrush="#4CAF50" FontWeight="Bold" Padding="18,6" Foreground="#FFFFFF" Click="OnSaveToWorldClick"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- MAIN BODY -->
        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/> <!-- Left Panel: Armor & Info -->
                <ColumnDefinition Width="16"/>  <!-- Spacer -->
                <ColumnDefinition Width="*"/>   <!-- Right Panel: Inventory & Ender Chest -->
            </Grid.ColumnDefinitions>

            <!-- LEFT PANEL: Armor, Offhand, Info -->
            <Border Grid.Column="0" Background="#181822" CornerRadius="8" BorderBrush="#2A2A3A" BorderThickness="1" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- World Summary Badge -->
                        <Border Background="#20202E" CornerRadius="6" Padding="12" Margin="0,0,0,14" BorderBrush="#323246" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="WORLD AKTIF" FontSize="10" FontWeight="Bold" Foreground="#8888AA"/>
                                <TextBlock x:Name="TxtActiveWorldName" Text="Belum ada world dimuat" FontSize="15" FontWeight="Bold" Foreground="#FFAA00" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                <TextBlock x:Name="TxtPlayerKey" Text="Key: ~local_player" FontSize="11" Foreground="#777799" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="ARMOR &amp; OFFHAND" FontWeight="Bold" FontSize="12" Foreground="#55FF55" Margin="0,0,0,10"/>

                        <!-- Equipment Slots Grid -->
                        <Grid HorizontalAlignment="Center" Margin="0,0,0,14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Armor Slots (Column 0) -->
                            <controls:InventorySlotControl x:Name="SlotHelmet" Grid.Row="0" Grid.Column="0" Margin="0,0,0,6"/>
                            <controls:InventorySlotControl x:Name="SlotChestplate" Grid.Row="1" Grid.Column="0" Margin="0,0,0,6"/>
                            <controls:InventorySlotControl x:Name="SlotLeggings" Grid.Row="2" Grid.Column="0" Margin="0,0,0,6"/>
                            <controls:InventorySlotControl x:Name="SlotBoots" Grid.Row="3" Grid.Column="0" Margin="0,0,0,0"/>

                            <!-- Offhand Slot (Column 2) -->
                            <StackPanel Grid.Row="1" Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Text="Offhand" FontSize="10" FontWeight="SemiBold" Foreground="#AAAAAA" HorizontalAlignment="Center" Margin="0,0,0,3"/>
                                <controls:InventorySlotControl x:Name="SlotOffhand"/>
                            </StackPanel>
                        </Grid>

                        <!-- Quick Guide Card -->
                        <Border Background="#121218" CornerRadius="6" Padding="10" BorderBrush="#252535" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="💡 Petunjuk Singkat:" FontWeight="Bold" FontSize="11" Foreground="#AAAAFF" Margin="0,0,0,4"/>
                                <TextBlock Text="• Drag &amp; Drop folder world / file .mcworld ke jendela ini." FontSize="10" Foreground="#8888AA" TextWrapping="Wrap" Margin="0,0,0,2"/>
                                <TextBlock Text="• Klik kiri pada slot mana pun untuk mengedit item atau enchantment." FontSize="10" Foreground="#8888AA" TextWrapping="Wrap" Margin="0,0,0,2"/>
                                <TextBlock Text="• Pastikan Minecraft ditutup sebelum menyimpan." FontSize="10" Foreground="#8888AA" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- RIGHT PANEL: Main Inventory & Ender Chest Tabs -->
            <Border Grid.Column="2" Background="#181822" CornerRadius="8" BorderBrush="#2A2A3A" BorderThickness="1" Padding="14">
                <TabControl Background="Transparent" BorderThickness="0">
                    
                    <!-- TAB 1: PLAYER INVENTORY & HOTBAR -->
                    <TabItem Header="🎒 Tas &amp; Hotbar Pemain">
                        <Grid Margin="0,14,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Main Bag Label -->
                                <RowDefinition Height="Auto"/> <!-- Main Bag Grid (3x9) -->
                                <RowDefinition Height="Auto"/> <!-- Separator / Hotbar Label -->
                                <RowDefinition Height="Auto"/> <!-- Hotbar Grid (1x9) -->
                            </Grid.RowDefinitions>

                            <!-- Main Bag Header -->
                            <TextBlock Grid.Row="0" Text="Tas Utama (Main Inventory • 27 Slot)" FontWeight="Bold" FontSize="12" Foreground="#BBBBCC" Margin="0,0,0,8"/>

                            <!-- Main Bag ItemsControl (3 Rows x 9 Columns) -->
                            <Border Grid.Row="1" Background="#121218" CornerRadius="6" Padding="8" BorderBrush="#282838" BorderThickness="1" HorizontalAlignment="Left">
                                <ItemsControl x:Name="ItemsBag">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="3" Columns="9"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <controls:InventorySlotControl Margin="2"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>

                            <!-- Hotbar Header -->
                            <TextBlock Grid.Row="2" Text="Hotbar Cepat (1x9 Slot)" FontWeight="Bold" FontSize="12" Foreground="#FFAA00" Margin="0,16,0,8"/>

                            <!-- Hotbar ItemsControl (1 Row x 9 Columns) -->
                            <Border Grid.Row="3" Background="#121218" CornerRadius="6" Padding="8" BorderBrush="#282838" BorderThickness="1" HorizontalAlignment="Left">
                                <ItemsControl x:Name="ItemsHotbar">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1" Columns="9"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <controls:InventorySlotControl Margin="2"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- TAB 2: ENDER CHEST -->
                    <TabItem Header="👁️ Ender Chest">
                        <Grid Margin="0,14,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Inventaris Ender Chest (27 Slot)" FontWeight="Bold" FontSize="12" Foreground="#BBBBCC" Margin="0,0,0,8"/>

                            <Border Grid.Row="1" Background="#121218" CornerRadius="6" Padding="8" BorderBrush="#282838" BorderThickness="1" HorizontalAlignment="Left">
                                <ItemsControl x:Name="ItemsEnderChest">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="3" Columns="9"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <controls:InventorySlotControl Margin="2"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </Grid>
                    </TabItem>

                </TabControl>
            </Border>
        </Grid>

        <!-- STATUS BAR -->
        <Border Grid.Row="2" Background="#101014" BorderBrush="#22222E" BorderThickness="0,1,0,0" Padding="14,6">
            <DockPanel LastChildFill="True">
                <!-- Right: Version Badge & Loaded Path -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtLoadedPath" Text="" Foreground="#666688" FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Border Background="#1C281C" BorderBrush="#2E5A2E" BorderThickness="1" CornerRadius="4" Padding="7,2" ToolTip="Versi Resmi 1.0 (Production Release)">
                        <TextBlock Text="v1.0" Foreground="#55FF55" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>

                <!-- Left: Status Message -->
                <TextBlock x:Name="TxtStatus" Text="Silakan buka folder world, pilih dari riwayat, atau drag &amp; drop ke jendela." Foreground="#9999BB" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

    </Grid>
</Window>
