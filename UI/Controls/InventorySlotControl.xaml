<UserControl x:Class="BedrockInventoryEditor.UI.Controls.InventorySlotControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:BedrockInventoryEditor.UI.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="56" d:DesignWidth="56"
             Width="52" Height="52" Margin="2"
             Cursor="Hand">
    <UserControl.Resources>
        <converters:EmptyToVisibilityConverter x:Key="EmptyToVis"/>
        <converters:CountToVisibilityConverter x:Key="CountToVis"/>
        <converters:ItemColorConverter x:Key="ItemColor"/>
        <converters:ItemImageConverter x:Key="ItemImage"/>
        <converters:ItemHasImageToVisibilityConverter x:Key="HasImageToVis"/>
        <converters:ItemIconConverter x:Key="ItemIcon"/>
        <converters:ItemShortLabelConverter x:Key="ItemShortLabel"/>
    </UserControl.Resources>

    <Border x:Name="OuterBorder" 
            BorderThickness="2" 
            CornerRadius="4"
            Background="#1E1E26" 
            BorderBrush="#3E3E4E"
            MouseDown="OnSlotMouseDown">
        <Border.Style>
            <Style TargetType="Border">
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="BorderBrush" Value="#55FF55"/>
                        <Setter Property="Background" Value="#2E2E3C"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid ClipToBounds="True">
            <!-- Background Watermark Icon for Empty Equipment Slots -->
            <TextBlock Text="{Binding WatermarkIcon}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="20"
                       Opacity="0.25"
                       Foreground="#AAAAAA"
                       Visibility="{Binding IsEmpty, Converter={StaticResource EmptyToVis}}"/>

            <!-- Item Main Content -->
            <Grid Visibility="{Binding IsEmpty, Converter={StaticResource EmptyToVis}, ConverterParameter=Invert}">
                <!-- Enchantment Glow Background -->
                <Border Background="#44AA00AA"
                        CornerRadius="2"
                        Margin="1"
                        Visibility="{Binding Enchantments.Count, Converter={StaticResource CountToVis}}"/>

                <!-- REAL MINECRAFT TEXTURE IMAGE (Pixel-Perfect NearestNeighbor) -->
                <Image Source="{Binding Id, Converter={StaticResource ItemImage}}"
                       Width="34" Height="34"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="NearestNeighbor"
                       Visibility="{Binding Id, Converter={StaticResource HasImageToVis}}">
                    <Image.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="2" ShadowDepth="1" Opacity="0.75"/>
                    </Image.Effect>
                </Image>

                <!-- Fallback Emoji / Icon (when image asset is not found) -->
                <TextBlock Text="{Binding Id, Converter={StaticResource ItemIcon}}"
                           FontSize="24"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="{Binding Id, Converter={StaticResource HasImageToVis}, ConverterParameter=Invert}">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="3" ShadowDepth="1" Opacity="0.8"/>
                    </TextBlock.Effect>
                </TextBlock>

                <!-- Count Badge (Bottom Right) -->
                <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Margin="0,0,2,1"
                        Visibility="{Binding Count, Converter={StaticResource CountToVis}}">
                    <TextBlock Text="{Binding Count}"
                               FontWeight="ExtraBold"
                               FontSize="12"
                               Foreground="#FFFFFF">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="2" ShadowDepth="1.5" Opacity="1"/>
                        </TextBlock.Effect>
                    </TextBlock>
                </Border>

                <!-- Enchanted Star Indicator (Top Left) -->
                <TextBlock Text="✦"
                           FontSize="12"
                           FontWeight="Bold"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"
                           Margin="2,1,0,0"
                           Foreground="#FFAAFF"
                           Visibility="{Binding Enchantments.Count, Converter={StaticResource CountToVis}}">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#AA00AA" BlurRadius="4" ShadowDepth="0" Opacity="1"/>
                    </TextBlock.Effect>
                </TextBlock>
            </Grid>

            <!-- Tooltip Preview with High-Contrast Dark Theme -->
            <Grid.ToolTip>
                <ToolTip Background="#181822" BorderBrush="#55FF55" BorderThickness="1" Foreground="#EEEEEE" Padding="10">
                    <StackPanel MaxWidth="280">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Image Source="{Binding Id, Converter={StaticResource ItemImage}}" 
                                   Width="24" Height="24" 
                                   Margin="0,0,8,0" 
                                   RenderOptions.BitmapScalingMode="NearestNeighbor"
                                   Visibility="{Binding Id, Converter={StaticResource HasImageToVis}}"/>
                            <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="14" Foreground="#FFAA00" VerticalAlignment="Center"/>
                        </StackPanel>
                        
                        <TextBlock Text="{Binding Id}" FontSize="11" Foreground="#AAAAAA" Margin="0,0,0,4"/>

                        <StackPanel Visibility="{Binding IsEmpty, Converter={StaticResource EmptyToVis}, ConverterParameter=Invert}">
                            <TextBlock Text="{Binding Count, StringFormat='Jumlah: {0}'}" FontSize="12" Foreground="#FFFFFF" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Damage, StringFormat='Damage: {0}'}" FontSize="11" Foreground="#CCCCCC" Visibility="{Binding Damage, Converter={StaticResource CountToVis}}"/>

                            <!-- Enchantments in Tooltip -->
                            <ItemsControl ItemsSource="{Binding Enchantments}" Margin="0,4,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Foreground="#77AAFF" FontSize="12">
                                            <Run Text="{Binding Name}"/>
                                            <Run Text=" "/>
                                            <Run Text="{Binding Level, StringFormat='Lvl {0}'}"/>
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Lore in Tooltip -->
                            <ItemsControl ItemsSource="{Binding Lore}" Margin="0,4,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontStyle="Italic" Foreground="#FFAAFF" FontSize="11"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <Border Background="#252535" CornerRadius="3" Padding="4,2" Margin="0,8,0,0">
                            <TextBlock Text="💡 Klik kiri untuk mengedit item" FontStyle="Italic" FontSize="10" Foreground="#55FF55" HorizontalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </ToolTip>
            </Grid.ToolTip>
        </Grid>
    </Border>
</UserControl>
