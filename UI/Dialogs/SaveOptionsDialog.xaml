<Window x:Class="BedrockInventoryEditor.UI.Dialogs.SaveOptionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="Simpan Perubahan ke LevelDB" 
        Icon="pack://application:,,,/BedrockInventoryEditor;component/Assets/app_icon.png"
        Height="290" Width="490"
        WindowStartupLocation="CenterOwner"
        Background="#0E1117" 
        Foreground="#F1F5F9"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title & Description -->
            <RowDefinition Height="*"/>    <!-- Options Buttons -->
            <RowDefinition Height="Auto"/> <!-- Cancel Button -->
        </Grid.RowDefinitions>

        <!-- TITLE -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Pilih Mode Penyimpanan" FontSize="16" FontWeight="Bold" Foreground="#10B981"/>
            <TextBlock Text="Pastikan game Minecraft sedang ditutup sebelum menyimpan." FontSize="12" Foreground="#94A3B8" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- ACTION BUTTONS -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <!-- Save Directly -->
            <ui:Button Icon="{ui:SymbolIcon Save24}"
                       Content="Simpan Langsung (Tanpa Backup)" 
                       Appearance="Primary" 
                       FontWeight="Bold" 
                       HorizontalAlignment="Stretch"
                       Padding="14,10"
                       Margin="0,0,0,10" 
                       Click="OnSaveDirectClick"/>

            <!-- Save with Backup -->
            <ui:Button Icon="{ui:SymbolIcon Archive24}"
                       Content="Simpan + Buat Backup (.zip)" 
                       Appearance="Secondary"
                       Foreground="#38BDF8"
                       FontWeight="Bold" 
                       HorizontalAlignment="Stretch"
                       Padding="14,10"
                       Click="OnSaveWithBackupClick"/>
        </StackPanel>

        <!-- CANCEL -->
        <ui:Button Grid.Row="2" 
                   Content="Batal" 
                   Appearance="Secondary"
                   HorizontalAlignment="Right" 
                   Padding="16,6" 
                   Margin="0,14,0,0" 
                   Click="OnCancelClick"/>
    </Grid>
</Window>
